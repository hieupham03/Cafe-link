# Runtime profiles, uploaded media, local secrets and backup archives.
/cafelink-system/data/
/cafelink-system/backups/
/cafelink-system/logs/
.env
.env.*
!.env.example
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.qr-key
*.pem
*.pfx
*.p12
*.log
~$*

